    "pidusage": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.0.2",
    "tree-kill": "^1.2.2",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
